rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'vemulavankeswararao@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'marketFocus', 'experienceMode', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'marketFocus', 'experienceMode', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.marketFocus is string && data.marketFocus.size() >= 2 && data.marketFocus.size() <= 64
        && data.experienceMode is string && data.experienceMode in ['newbie', 'pro']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWatchlistItem(data) {
      return data.keys().hasAll(['ownerId', 'symbol', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'symbol', 'note', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 24
        && data.symbol.matches('^[A-Z0-9.\\-]+$')
        && (!('note' in data) || (data.note is string && data.note.size() <= 240))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDeskAlert(data) {
      return data.keys().hasAll(['ownerId', 'symbol', 'condition', 'targetPrice', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'symbol', 'condition', 'targetPrice', 'status', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 24
        && data.symbol.matches('^[A-Z0-9.\\-]+$')
        && data.condition is string && data.condition in ['above', 'below']
        && data.targetPrice is number && data.targetPrice > 0
        && data.status is string && data.status in ['active', 'triggered']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWalletChainRecord(data) {
      return data.keys().hasAll(['ownerId', 'chain', 'assetSymbol', 'depositAddress', 'dailyLimitUsd', 'strictAllowlist', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'chain', 'assetSymbol', 'depositAddress', 'dailyLimitUsd', 'strictAllowlist', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.chain is string && data.chain in ['BTC', 'ETH', 'SOL', 'MATIC', 'ARB', 'BASE', 'TRX']
        && data.assetSymbol is string && data.assetSymbol.size() >= 2 && data.assetSymbol.size() <= 12
        && data.assetSymbol.matches('^[A-Z0-9]+$')
        && data.depositAddress is string && data.depositAddress.size() >= 16 && data.depositAddress.size() <= 128
        && data.depositAddress.matches('^[a-zA-Z0-9]+$')
        && data.dailyLimitUsd is number && data.dailyLimitUsd >= 0 && data.dailyLimitUsd <= 10000000
        && data.strictAllowlist is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWithdrawalAllowlistEntry(data) {
      return data.keys().hasAll(['ownerId', 'label', 'chain', 'address', 'enabled', 'threatStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'label', 'chain', 'address', 'enabled', 'threatStatus', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 64
        && data.chain is string && data.chain in ['BTC', 'ETH', 'SOL', 'MATIC', 'ARB', 'BASE', 'TRX']
        && data.address is string && data.address.size() >= 16 && data.address.size() <= 128
        && data.address.matches('^[a-zA-Z0-9]+$')
        && data.enabled is bool
        && data.threatStatus is string && data.threatStatus in ['CLEAN', 'SUSPICIOUS', 'BLOCKED']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSecurityAuditSnapshot(data) {
      return data.keys().hasAll(['ownerId', 'overallScorePct', 'passedCount', 'warnCount', 'failCount', 'summary', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'overallScorePct', 'passedCount', 'warnCount', 'failCount', 'summary', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.overallScorePct is number && data.overallScorePct >= 0 && data.overallScorePct <= 100
        && data.passedCount is number && data.passedCount >= 0
        && data.warnCount is number && data.warnCount >= 0
        && data.failCount is number && data.failCount >= 0
        && data.summary is string && data.summary.size() >= 4 && data.summary.size() <= 240
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlatformNotificationRecord(data) {
      return data.keys().hasAll(['ownerId', 'category', 'severity', 'title', 'message', 'read', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'category', 'severity', 'title', 'message', 'read', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.category is string && data.category in ['SECURITY_429', 'VERIFICATION', 'COIN_LAUNCH', 'PASSWORD_RECOVERY', 'TRADING', 'LIMIT_BREACH']
        && data.severity is string && data.severity in ['INFO', 'WARNING', 'CRITICAL']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && data.message is string && data.message.size() >= 2 && data.message.size() <= 400
        && data.read is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVerificationStatusRecord(data) {
      return data.keys().hasAll(['ownerId', 'profileVerified', 'documentStatus', 'bankVerificationStatus', 'overallTier', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'profileVerified', 'documentStatus', 'bankVerificationStatus', 'overallTier', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.profileVerified is bool
        && data.documentStatus is string && data.documentStatus in ['NOT_SUBMITTED', 'PENDING_REVIEW', 'VERIFIED', 'REJECTED']
        && data.bankVerificationStatus is string && data.bankVerificationStatus in ['NOT_STARTED', 'MICRO_DEPOSIT_SENT', 'VERIFIED', 'FAILED']
        && data.overallTier is string && data.overallTier.size() >= 4 && data.overallTier.size() <= 48
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCoinLaunchStatusRecord(data) {
      return data.keys().hasAll(['ownerId', 'symbol', 'name', 'chain', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'symbol', 'name', 'chain', 'status', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.symbol is string && data.symbol.size() >= 2 && data.symbol.size() <= 16
        && data.symbol.matches('^[A-Z0-9\\-]+$')
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 64
        && data.chain is string && data.chain in ['BTC', 'ETH', 'SOL', 'MATIC', 'ARB', 'BASE', 'TRX']
        && data.status is string && data.status in ['PENDING_REVIEW', 'APPROVED_LISTED', 'REJECTED']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list, write: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'marketFocus', 'experienceMode', 'updatedAt']))
        );

      allow delete: if isValidId(userId) && isAdmin();

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if false;

        allow create: if isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isVerifiedUser()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserPrivateInfo(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isVerifiedUser()
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']))
          );

        allow delete: if isValidId(userId) && isValidId(docId) && isAdmin();
      }

      match /watchlists/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

        allow create: if isValidId(userId)
          && isValidId(itemId)
          && isVerifiedUser()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidWatchlistItem(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && isValidId(itemId)
          && isVerifiedUser()
          && isValidWatchlistItem(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().symbol == existing().symbol
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['note', 'updatedAt']))
          );

        allow delete: if isValidId(userId) && isValidId(itemId) && (isOwner(userId) || isAdmin());
      }

      match /alerts/{alertId} {
        allow get: if isValidId(userId) && isValidId(alertId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

        allow create: if isValidId(userId)
          && isValidId(alertId)
          && isVerifiedUser()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidDeskAlert(incoming())
          && incoming().status == 'active'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && isValidId(alertId)
          && isVerifiedUser()
          && isValidDeskAlert(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().symbol == existing().symbol
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isOwner(userId)
              && existing().status != 'triggered'
              && (
                (incoming().status == 'active' && incoming().diff(existing()).affectedKeys().hasOnly(['condition', 'targetPrice', 'updatedAt'])) ||
                (incoming().status == 'triggered' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
              )
            )
          );

        allow delete: if isValidId(userId) && isValidId(alertId) && (isOwner(userId) || isAdmin());
      }

      match /wallets/{chainId} {
        allow get: if isValidId(userId) && isValidId(chainId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

        allow create: if isValidId(userId)
          && isValidId(chainId)
          && isVerifiedUser()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidWalletChainRecord(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && isValidId(chainId)
          && isVerifiedUser()
          && isValidWalletChainRecord(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().chain == existing().chain
          && incoming().assetSymbol == existing().assetSymbol
          && incoming().depositAddress == existing().depositAddress
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['dailyLimitUsd', 'strictAllowlist', 'updatedAt']))
          );

        allow delete: if isValidId(userId) && isValidId(chainId) && isAdmin();
      }

      match /allowlists/{entryId} {
        allow get: if isValidId(userId) && isValidId(entryId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

        allow create: if isValidId(userId)
          && isValidId(entryId)
          && isVerifiedUser()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidWithdrawalAllowlistEntry(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && isValidId(entryId)
          && isVerifiedUser()
          && isValidWithdrawalAllowlistEntry(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().chain == existing().chain
          && incoming().address == existing().address
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isOwner(userId)
              && existing().threatStatus != 'BLOCKED'
              && incoming().diff(existing()).affectedKeys().hasOnly(['label', 'enabled', 'updatedAt'])
            )
          );

        allow delete: if isValidId(userId) && isValidId(entryId) && (isOwner(userId) || isAdmin());
      }

      match /securityAudits/{auditId} {
        allow get: if isValidId(userId) && isValidId(auditId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

        allow create: if isValidId(userId)
          && isValidId(auditId)
          && isVerifiedUser()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidSecurityAuditSnapshot(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId) && isValidId(auditId) && isAdmin();
        allow delete: if isValidId(userId) && isValidId(auditId) && isAdmin();
      }

      match /notifications/{notificationId} {
        allow get: if isValidId(userId) && isValidId(notificationId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

        allow create: if isValidId(userId)
          && isValidId(notificationId)
          && isVerifiedUser()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidPlatformNotificationRecord(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && isValidId(notificationId)
          && isVerifiedUser()
          && isValidPlatformNotificationRecord(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().category == existing().category
          && incoming().severity == existing().severity
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']))
          );

        allow delete: if isValidId(userId) && isValidId(notificationId) && (isOwner(userId) || isAdmin());
      }

      match /verifications/{verificationId} {
        allow get: if isValidId(userId) && isValidId(verificationId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

        allow create: if isValidId(userId)
          && isValidId(verificationId)
          && isVerifiedUser()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidVerificationStatusRecord(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && isValidId(verificationId)
          && isVerifiedUser()
          && isValidVerificationStatusRecord(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['profileVerified', 'documentStatus', 'bankVerificationStatus', 'overallTier', 'updatedAt']))
          );

        allow delete: if isValidId(userId) && isValidId(verificationId) && isAdmin();
      }

      match /coinLaunches/{launchId} {
        allow get: if isValidId(userId) && isValidId(launchId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

        allow create: if isValidId(userId)
          && isValidId(launchId)
          && isVerifiedUser()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidCoinLaunchStatusRecord(incoming())
          && incoming().status == 'PENDING_REVIEW'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && isValidId(launchId)
          && isAdmin()
          && isValidCoinLaunchStatusRecord(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().symbol == existing().symbol
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time;

        allow delete: if isValidId(userId) && isValidId(launchId) && isAdmin();
      }
    }
  }
}
