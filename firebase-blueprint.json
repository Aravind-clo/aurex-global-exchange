{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Non-PII workspace profile and preferences for an authenticated Meridian trader",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the account owner"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name shown on the trading desk"
        },
        "marketFocus": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "description": "Primary asset class or regional market focus"
        },
        "experienceMode": {
          "type": "string",
          "enum": ["newbie", "pro"],
          "description": "UI guidance level"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update"
        }
      },
      "required": ["uid", "displayName", "marketFocus", "experienceMode", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Owner-isolated PII record containing verified email and desk contact metadata",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the owner"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Verified account email address"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "WatchlistItem": {
      "title": "WatchlistItem",
      "description": "User-pinned market instrument inside a personal watchlist",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the parent user document"
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[A-Z0-9.\\-]+$",
          "description": "Instrument ticker symbol"
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240,
          "description": "Optional trade thesis note"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["ownerId", "symbol", "createdAt", "updatedAt"]
    },
    "DeskAlert": {
      "title": "DeskAlert",
      "description": "User-configured real-time price alert rule",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the alert owner"
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[A-Z0-9.\\-]+$",
          "description": "Target instrument ticker"
        },
        "condition": {
          "type": "string",
          "enum": ["above", "below"],
          "description": "Trigger direction"
        },
        "targetPrice": {
          "type": "number",
          "description": "Trigger price threshold"
        },
        "status": {
          "type": "string",
          "enum": ["active", "triggered"],
          "description": "Alert lifecycle status (triggered is terminal)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["ownerId", "symbol", "condition", "targetPrice", "status", "createdAt", "updatedAt"]
    },
    "WalletChainRecord": {
      "title": "WalletChainRecord",
      "description": "Owner-scoped multi-chain deposit address and spend velocity policy record",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "chain": {
          "type": "string",
          "enum": ["BTC", "ETH", "SOL", "MATIC", "ARB", "BASE", "TRX"]
        },
        "assetSymbol": {
          "type": "string",
          "minLength": 2,
          "maxLength": 12,
          "pattern": "^[A-Z0-9]+$"
        },
        "depositAddress": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9]+$"
        },
        "dailyLimitUsd": {
          "type": "number"
        },
        "strictAllowlist": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "chain", "assetSymbol", "depositAddress", "dailyLimitUsd", "strictAllowlist", "createdAt", "updatedAt"]
    },
    "WithdrawalAllowlistEntry": {
      "title": "WithdrawalAllowlistEntry",
      "description": "Owner-verified external withdrawal address with enable toggle and threat screening status",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "chain": {
          "type": "string",
          "enum": ["BTC", "ETH", "SOL", "MATIC", "ARB", "BASE", "TRX"]
        },
        "address": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "threatStatus": {
          "type": "string",
          "enum": ["CLEAN", "SUSPICIOUS", "BLOCKED"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "label", "chain", "address", "enabled", "threatStatus", "createdAt", "updatedAt"]
    },
    "SecurityAuditSnapshot": {
      "title": "SecurityAuditSnapshot",
      "description": "Immutable live runtime security audit summary snapshot",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "overallScorePct": {
          "type": "number"
        },
        "passedCount": {
          "type": "number"
        },
        "warnCount": {
          "type": "number"
        },
        "failCount": {
          "type": "number"
        },
        "summary": {
          "type": "string",
          "minLength": 4,
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "overallScorePct", "passedCount", "warnCount", "failCount", "summary", "createdAt", "updatedAt"]
    },
    "PlatformNotificationRecord": {
      "title": "PlatformNotificationRecord",
      "description": "Owner-scoped alert notification synced from the backend notification engine",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["SECURITY_429", "VERIFICATION", "COIN_LAUNCH", "PASSWORD_RECOVERY", "TRADING", "LIMIT_BREACH"]
        },
        "severity": {
          "type": "string",
          "enum": ["INFO", "WARNING", "CRITICAL"]
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "minLength": 2,
          "maxLength": 400
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "category", "severity", "title", "message", "read", "createdAt", "updatedAt"]
    },
    "VerificationStatusRecord": {
      "title": "VerificationStatusRecord",
      "description": "Non-PII verification tier status across Profile, Document, and Bank Penny-Drop checks",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "profileVerified": {
          "type": "boolean"
        },
        "documentStatus": {
          "type": "string",
          "enum": ["NOT_SUBMITTED", "PENDING_REVIEW", "VERIFIED", "REJECTED"]
        },
        "bankVerificationStatus": {
          "type": "string",
          "enum": ["NOT_STARTED", "MICRO_DEPOSIT_SENT", "VERIFIED", "FAILED"]
        },
        "overallTier": {
          "type": "string",
          "minLength": 4,
          "maxLength": 48
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "profileVerified", "documentStatus", "bankVerificationStatus", "overallTier", "createdAt", "updatedAt"]
    },
    "CoinLaunchStatusRecord": {
      "title": "CoinLaunchStatusRecord",
      "description": "Issuer-scoped coin registration and launchpad listing status",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "symbol": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "chain": {
          "type": "string",
          "enum": ["BTC", "ETH", "SOL", "MATIC", "ARB", "BASE", "TRX"]
        },
        "status": {
          "type": "string",
          "enum": ["PENDING_REVIEW", "APPROVED_LISTED", "REJECTED"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "symbol", "name", "chain", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-scoped non-PII user trading desk profile"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-isolated PII subcollection holding verified email"
    },
    "/users/{userId}/watchlists/{itemId}": {
      "schema": { "$ref": "#/entities/WatchlistItem" },
      "description": "Personal watchlist items synchronized across Android, iOS, macOS, and Windows"
    },
    "/users/{userId}/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/DeskAlert" },
      "description": "User price alert rules with terminal triggered locking"
    },
    "/users/{userId}/wallets/{chainId}": {
      "schema": { "$ref": "#/entities/WalletChainRecord" },
      "description": "Owner-scoped multi-chain custody deposit wallet and velocity limits"
    },
    "/users/{userId}/allowlists/{entryId}": {
      "schema": { "$ref": "#/entities/WithdrawalAllowlistEntry" },
      "description": "Owner-scoped verified withdrawal allowlist destinations"
    },
    "/users/{userId}/securityAudits/{auditId}": {
      "schema": { "$ref": "#/entities/SecurityAuditSnapshot" },
      "description": "Owner-scoped live vibe-security audit summary records"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/PlatformNotificationRecord" },
      "description": "Owner-scoped app and security alerts"
    },
    "/users/{userId}/verifications/{verificationId}": {
      "schema": { "$ref": "#/entities/VerificationStatusRecord" },
      "description": "Owner-scoped top-tier verification progress"
    },
    "/users/{userId}/coinLaunches/{launchId}": {
      "schema": { "$ref": "#/entities/CoinLaunchStatusRecord" },
      "description": "Issuer-scoped coin launchpad registration status"
    }
  }
}
