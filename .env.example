# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VAULT_MASTER_KEY: Production 32+ char operator secret used to derive AES-256-GCM vault & HMAC ledger keys.
# When unset in container/preview runtimes, the server provisions & seals a 256-bit persistent key in data/.vault-master.key (0600, gitignored & 403-isolated).
VAULT_MASTER_KEY=""
# CUSTOM_ALLOWED_DOMAINS: Optional comma-separated custom production domains for CSRF/Origin verification
CUSTOM_ALLOWED_DOMAINS=""

# Social OAuth Providers (Optional — enables Google & GitHub popup sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Private GitHub Auth Server & Organization Isolation (Optional)
GITHUB_SERVER_BASE_URL="https://github.com"
GITHUB_API_BASE_URL="https://api.github.com"
GITHUB_PRIVATE_SERVER_TOKEN=""
GITHUB_ALLOWED_ORG=""

# Firebase Web Client API Key (provide at runtime via environment / secrets manager)
VITE_FIREBASE_API_KEY=""

# Optional Runtime API License Keys
AUREX_INSTITUTIONAL_API_KEY=""
AUREX_PRO_API_KEY=""
